# Local phpBB site generated by seed-forum. Placeholders are internal.
server {
	listen 127.0.0.1:{{PORT}};
	listen [::1]:{{PORT}};
	server_name {{SERVER_NAME}};
	root {{BOARD_ROOT}};

	index index.php index.html index.htm;

	access_log /var/log/nginx/{{SITE_NAME}}.access.log;
	error_log /var/log/nginx/{{SITE_NAME}}.error.log warn;

	# Documentation must be served through phpBB's permission-checked routes.
	location ^~ /ext/phpbbmodders/documentation/docs-build/ {
		deny all;
	}

	location / {
		try_files $uri $uri/ @rewriteapp;

		location ~ \.php(/|$) {
			include fastcgi.conf;
			fastcgi_split_path_info ^(.+\.php)(/.*)$;
			fastcgi_param PATH_INFO $fastcgi_path_info;
			fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
			fastcgi_param DOCUMENT_ROOT $realpath_root;
			try_files $uri $uri/ /app.php$is_args$args;
			fastcgi_pass unix:{{PHP_FPM_SOCKET}};
		}

		location ~ /(config|common\.php|composer\.(json|lock)|cache|files|images/avatars/upload|includes|(?<!ext/)phpbb(?!\w+)|store|vendor) {
			deny all;
			internal;
		}

		# nginx ignores .htaccess entirely - the extension's own
		# attachment directory needs an explicit deny here too.
		location ~ ^/ext/[^/]+/[^/]+/files/ {
			deny all;
			internal;
		}
	}

	location @rewriteapp {
		rewrite ^(.*)$ /app.php/$1 last;
	}

	location /install/ {
		try_files $uri $uri/ @rewrite_installapp =404;

		location ~ \.php(/|$) {
			include fastcgi.conf;
			fastcgi_split_path_info ^(.+\.php)(/.*)$;
			fastcgi_param PATH_INFO $fastcgi_path_info;
			fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
			fastcgi_param DOCUMENT_ROOT $realpath_root;
			try_files $uri $uri/ /install/app.php$is_args$args =404;
			fastcgi_pass unix:{{PHP_FPM_SOCKET}};
		}
	}

	location @rewrite_installapp {
		rewrite ^(.*)$ /install/app.php/$1 last;
	}

	location ~ /\.svn|/\.git|/\.seed-forum {
		deny all;
		internal;
	}
}
